{
  "_doc": "Canonical metric 登記表。reconciler 用 id 對齊不同文件的同一指標（aliases），recompute.py 用 formula 重算 derived 值。formula 內的名字都是本表的 id；tolerance_pct 是判定一致的容忍差。",
  "metrics": [
    { "id": "revenue", "label": "營收", "aliases": ["revenue", "total revenue", "營業收入", "營收", "銷貨收入", "sales"], "unit": "currency" },
    { "id": "revenue_subscription", "label": "訂閱營收", "aliases": ["subscription revenue", "訂閱收入", "recurring revenue", "授權收入"], "unit": "currency" },
    { "id": "revenue_usage", "label": "用量營收", "aliases": ["usage fees", "usage revenue", "用量收入", "per-pick revenue"], "unit": "currency" },
    { "id": "revenue_hardware", "label": "硬體/安裝營收", "aliases": ["hardware sales", "hardware sales & install", "整機銷售", "商品銷售", "設備銷售"], "unit": "currency" },
    { "id": "cogs", "label": "營業成本", "aliases": ["cost of revenue", "cost of goods sold", "COGS", "營業成本", "銷貨成本"], "unit": "currency" },
    { "id": "gross_profit", "label": "毛利", "aliases": ["gross profit", "毛利", "營業毛利"], "unit": "currency", "formula": "revenue - cogs", "tolerance_pct": 0.5 },
    { "id": "gross_margin", "label": "毛利率", "aliases": ["gross margin", "GM", "毛利率", "gross margin %"], "unit": "pct", "formula": "gross_profit / revenue", "tolerance_pct": 1.0 },
    { "id": "opex", "label": "營業費用", "aliases": ["operating expenses", "opex", "營業費用", "總營業費用"], "unit": "currency" },
    { "id": "operating_income", "label": "營業利益/損失", "aliases": ["operating income", "operating loss", "營業利益", "營業損失", "EBIT"], "unit": "currency", "formula": "gross_profit - opex", "tolerance_pct": 0.5 },
    { "id": "net_income", "label": "淨利/淨損", "aliases": ["net income", "net loss", "本期淨利", "本期淨損", "稅後淨利"], "unit": "currency" },
    { "id": "cash", "label": "現金及約當現金", "aliases": ["cash", "cash and equivalents", "現金及約當現金", "現金"], "unit": "currency" },
    { "id": "accounts_receivable", "label": "應收帳款", "aliases": ["accounts receivable", "AR", "應收帳款", "應收票據及帳款"], "unit": "currency" },
    { "id": "dso_days", "label": "應收帳款天數", "aliases": ["DSO", "days sales outstanding", "應收帳款天數", "應收帳款週轉天數", "收現天數"], "unit": "days", "formula": "accounts_receivable / revenue * 365", "tolerance_pct": 5.0 },
    { "id": "inventory", "label": "存貨", "aliases": ["inventory", "存貨"], "unit": "currency" },
    { "id": "deferred_revenue", "label": "預收/合約負債", "aliases": ["deferred revenue", "contract liabilities", "預收款", "預收貨款", "合約負債"], "unit": "currency" },
    { "id": "prepayments", "label": "預付款", "aliases": ["prepayments", "prepaid", "預付款", "預付貨款", "預付投資款"], "unit": "currency" },
    { "id": "debt", "label": "借款/負債", "aliases": ["long-term debt", "borrowings", "credit facility", "長期借款", "銀行借款", "信用額度"], "unit": "currency" },
    { "id": "burn_monthly", "label": "月燒錢", "aliases": ["monthly burn", "burn rate", "月燒錢"], "unit": "currency", "formula": "-operating_income / 12", "tolerance_pct": 5.0 },
    { "id": "runway_months", "label": "現金跑道（月）", "aliases": ["runway", "現金跑道"], "unit": "months", "formula": "cash / burn_monthly", "tolerance_pct": 10.0 },
    { "id": "shares_outstanding", "label": "已發行股數", "aliases": ["shares outstanding", "total shares", "已發行股數", "發行股數", "實收股數"], "unit": "shares" },
    { "id": "holder_shares", "label": "股東持股數", "aliases": ["shares held", "持股數", "股數"], "unit": "shares" },
    { "id": "holder_pct", "label": "股東持股比例", "aliases": ["ownership %", "持股比例", "持股%", "股權比例"], "unit": "pct", "formula": "holder_shares / shares_outstanding", "tolerance_pct": 0.5 },
    { "id": "esop_pool_pct", "label": "ESOP 池比例", "aliases": ["ESOP", "option pool", "員工認股", "選擇權池"], "unit": "pct" },
    { "id": "top1_customer_pct", "label": "最大客戶占營收", "aliases": ["largest customer", "top customer %", "最大客戶占比", "客戶集中度"], "unit": "pct" },
    { "id": "topn_customer_pct", "label": "Top-N 客戶合計占營收", "aliases": ["top 10 customers", "top-10 %", "前十大客戶占比", "前五大客戶"], "unit": "pct" },
    { "id": "nrr", "label": "淨營收留存率", "aliases": ["NRR", "net revenue retention", "淨留存", "NDR"], "unit": "pct" },
    { "id": "arpa", "label": "每客戶/每站點月費", "aliases": ["MRR per site", "ARPA", "ARPU", "每站點月費", "每客戶月費"], "unit": "currency" },
    { "id": "sites", "label": "站點/客戶數", "aliases": ["sites", "customers", "accounts", "站點數", "客戶數", "裝機數", "install base"], "unit": "count" },
    { "id": "units", "label": "機台/機器人數", "aliases": ["robots", "machines", "units deployed", "機器人台數", "機台數", "裝機台數"], "unit": "count" },
    { "id": "headcount", "label": "員工人數", "aliases": ["headcount", "employees", "team of", "員工人數", "人數"], "unit": "count" },
    { "id": "pre_money", "label": "投前估值", "aliases": ["pre-money", "pre-money valuation", "投前估值"], "unit": "currency" },
    { "id": "round_size", "label": "本輪募資金額", "aliases": ["raise", "round size", "募資金額", "本輪金額"], "unit": "currency" },
    { "id": "post_money", "label": "投後估值", "aliases": ["post-money", "post-money valuation", "投後估值"], "unit": "currency", "formula": "pre_money + round_size", "tolerance_pct": 0.5 },
    { "id": "price_per_share", "label": "每股價格", "aliases": ["price per share", "每股價格", "每股發行價"], "unit": "currency", "formula": "pre_money / shares_outstanding", "tolerance_pct": 1.0 },
    { "id": "contract_expiry", "label": "合約到期日", "aliases": ["contract expiry", "expiration", "term end", "合約到期", "到期日"], "unit": "date" },
    { "id": "pledged_assets", "label": "質押/擔保資產", "aliases": ["pledged", "collateral", "security interest", "質押", "擔保", "設質"], "unit": "text" },
    { "id": "related_party", "label": "關係人交易", "aliases": ["related party", "關係人", "關係人交易", "affiliate transactions"], "unit": "text" },
    { "id": "subsequent_event", "label": "期後事項", "aliases": ["subsequent events", "期後事項", "資產負債表日後事項"], "unit": "text" },
    { "id": "coverage_gap", "label": "文件未涵蓋的期間/項目", "aliases": ["gap", "缺件", "未涵蓋"], "unit": "text" }
  ]
}
